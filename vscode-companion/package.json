{
  "name": "codex-switcher-companion",
  "publisher": "codex-switcher-demo",
  "displayName": "Codex Switcher Companion",
  "description": "Connect this editor window to the local Codex switcher and reload it after a source switch.",
  "version": "0.1.4",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexSwitcher.connect",
        "title": "Codex Switcher: Connect this window"
      }
    ],
    "configuration": {
      "title": "Codex Switcher",
      "properties": {
        "codexSwitcher.connectionFile": {
          "type": "string",
          "default": "",
          "description": "Optional local switcher connection.json path."
        }
      }
    }
  },
  "license": "MIT"
}
