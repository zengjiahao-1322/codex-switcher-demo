{
  "name": "codex-switcher-remote",
  "publisher": "codex-switcher-demo",
  "displayName": "Codex Switcher Remote Agent",
  "description": "Runs on the Remote-SSH server so the local Codex switcher can switch the server's Codex configuration.",
  "version": "0.1.6-rc.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:codexSwitcherRemote.status",
    "onCommand:codexSwitcherRemote.read",
    "onCommand:codexSwitcherRemote.readAuth",
    "onCommand:codexSwitcherRemote.write",
    "onCommand:codexSwitcherRemote.restart"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexSwitcherRemote.status",
        "title": "Codex Switcher: Remote Status"
      },
      {
        "command": "codexSwitcherRemote.read",
        "title": "Codex Switcher: Remote Read"
      },
      {
        "command": "codexSwitcherRemote.readAuth",
        "title": "Codex Switcher: Remote Read Auth"
      },
      {
        "command": "codexSwitcherRemote.write",
        "title": "Codex Switcher: Remote Write"
      },
      {
        "command": "codexSwitcherRemote.restart",
        "title": "Codex Switcher: Remote Restart"
      }
    ]
  },
  "extensionKind": [
    "workspace"
  ],
  "license": "MIT"
}
